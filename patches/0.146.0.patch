@@ -0,0 +1,250 @@
+//! Append-only ledger of user input queued while a turn is running.
+//!
+//! # Why this exists
+//!
+//! When a user submits while a turn is in flight, the message becomes a
+//! *steer*: `submit_user_message` hands it to core and parks a `PendingSteer` in
+//! `InputQueueState::pending_steers`. codex shows these under "Messages to be
+//! submitted after next tool call". Core holds it in its own in-memory pending
+//! input and writes nothing to the rollout until it injects the message at the
+//! next tool-call boundary. Until then nothing outside the process can observe
+//! that the message was accepted -- and if it is pulled back out (Esc, a
+//! rejected steer, a thread switch), nothing observes that either.
+//!
+//! Note this is `pending_steers`, not `queued_user_messages`. Despite the name,
+//! the latter is not the mid-turn queue -- it is the "TUI cannot submit at all"
+//! buffer (session still booting, a plan streaming, a `!shell` command running,
+//! or a settings modal open) and is drained only once no turn is running.
+//!
+//! # The ledger model
+//!
+//! A harness driving codex (Minds) renders the queue by folding this file, the
+//! same way it folds Claude Code's `queue-operation` records: every entry that
+//! enters the queue gets an `queued_input` record, and every entry that leaves
+//! it gets exactly one terminating record. The conservation law a reader may
+//! rely on:
+//!
+//! ```text
+//! queued_input = queued_committed + queued_retracted
+//! ```
+//!
+//! so replaying the whole file nets to exactly the still-pending set, with no
+//! durable cursor. Resolution is by `queued_id`, never by content -- text
+//! matching cannot tell two identical messages apart and cannot represent a
+//! retraction at all.
+//!
+//! - `queued_committed`: the steer was injected into the turn (or resubmitted
+//!   as part of a merged post-interrupt turn). The message text now lands in
+//!   the rollout as an ordinary `user_message`; when the steer was injected
+//!   directly, that rollout record carries this `queued_id` as its `client_id`.
+//! - `queued_retracted`: the steer left the queue without committing as
+//!   written -- drained back into the composer on interrupt, bounced by core
+//!   (`ActiveTurnNotSteerable`), or dropped by a thread switch/clear.
+//!
+//! # Why a sidecar and not the rollout
+//!
+//! The rollout JSONL is written by core, and the TUI reaches core through the
+//! app-server protocol -- there is no path for it to append a rollout item
+//! without a new protocol request, a processor, and a core handler, across four
+//! crates. A separate file that only the TUI writes needs none of that, and
+//! introduces no second writer to a file core owns (core also rotates and
+//! truncates the rollout, so an outside append is not merely racy).
+//!
+//! The trade-off is that these records are not part of the durable session and
+//! do not survive `codex resume` or a thread switch: `restore_thread_input_state`
+//! closes every live entry as retracted, and restored steers carry no id. That
+//! is acceptable -- the ledger answers "what is pending, right now", and the
+//! durable record of a message is the rollout turn it becomes.
+//!
+//! # Format
+//!
+//! One JSON object per line, at `$CODEX_HOME/queued_input.jsonl`:
+//!
+//! ```json
+//! {"type":"queued_input","queued_id":"...","thread_id":"...","timestamp":"...","content":"..."}
+//! {"type":"queued_committed","queued_id":"...","timestamp":"..."}
+//! {"type":"queued_retracted","queued_id":"...","timestamp":"..."}
+//! ```
+//!
+//! Terminating records deliberately carry no content: the content is already on
+//! the enqueue record, and re-emitting it would invite the two to disagree.
+
+use std::fs::OpenOptions;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+
+const QUEUED_INPUT_LOG_FILENAME: &str = "queued_input.jsonl";
+
+fn queued_input_log_path(codex_home: &Path) -> PathBuf {
+    codex_home.join(QUEUED_INPUT_LOG_FILENAME)
+}
+
+fn rfc3339_now() -> String {
+    chrono::Utc::now().to_rfc3339_opts(chrono::SecondsFormat::Millis, true)
+}
+
+/// Serialize one `queued_input` record, newline-terminated.
+///
+/// Split out from the write so it can be asserted on without touching a
+/// filesystem.
+fn queued_input_record(
+    queued_id: &str,
+    thread_id: Option<&str>,
+    timestamp: &str,
+    content: &str,
+) -> String {
+    let record = serde_json::json!({
+        "type": "queued_input",
+        "queued_id": queued_id,
+        "thread_id": thread_id,
+        "timestamp": timestamp,
+        "content": content,
+    });
+    format!("{record}\n")
+}
+
+/// Serialize one terminating record (`queued_committed` / `queued_retracted`).
+fn queued_terminal_record(record_type: &str, queued_id: &str, timestamp: &str) -> String {
+    let record = serde_json::json!({
+        "type": record_type,
+        "queued_id": queued_id,
+        "timestamp": timestamp,
+    });
+    format!("{record}\n")
+}
+
+/// Append one line to the ledger.
+///
+/// Best-effort by design: this is observability for an external watcher, so a
+/// failure to write must never interfere with the input path it observes.
+/// Errors are traced and swallowed.
+///
+/// O_APPEND: writes under the size of a pipe buffer are atomic, so a reader
+/// tailing this file never sees a half-written line even if some other codex
+/// process shares this CODEX_HOME.
+fn append_line(codex_home: &Path, line: &str) {
+    let write_result = OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(queued_input_log_path(codex_home))
+        .and_then(|mut file| file.write_all(line.as_bytes()));
+    if let Err(err) = write_result {
+        tracing::warn!("failed to append queued-input ledger record: {err}");
+    }
+}
+
+/// Record that `content` entered the pending-steer queue under `queued_id`.
+///
+/// The id is minted by the caller (`PendingSteer` construction) rather than
+/// here, because the same id is also threaded into the turn's
+/// `client_user_message_id` so the committed rollout `user_message` carries it.
+pub(super) fn append_queued_input(
+    codex_home: &Path,
+    queued_id: &str,
+    thread_id: Option<&str>,
+    content: &str,
+) {
+    let line = queued_input_record(queued_id, thread_id, &rfc3339_now(), content);
+    append_line(codex_home, &line);
+}
+
+/// Record that the steer under `queued_id` was injected into a turn.
+pub(super) fn append_queued_committed(codex_home: &Path, queued_id: &str) {
+    let line = queued_terminal_record("queued_committed", queued_id, &rfc3339_now());
+    append_line(codex_home, &line);
+}
+
+/// Record that the steer under `queued_id` left the queue without committing.
+pub(super) fn append_queued_retracted(codex_home: &Path, queued_id: &str) {
+    let line = queued_terminal_record("queued_retracted", queued_id, &rfc3339_now());
+    append_line(codex_home, &line);
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::fs;
+
+    #[test]
+    fn minds_queued_input_record_is_one_json_line() {
+        let line = queued_input_record("qid-1", Some("thread-1"), "2026-01-01T00:00:00.000Z", "hi");
+        assert!(line.ends_with('\n'), "record must be newline-terminated");
+        assert_eq!(
+            line.matches('\n').count(),
+            1,
+            "record must be a single line"
+        );
+
+        let parsed: serde_json::Value =
+            serde_json::from_str(line.trim_end()).expect("record should be valid JSON");
+        assert_eq!(parsed["type"], "queued_input");
+        assert_eq!(parsed["queued_id"], "qid-1");
+        assert_eq!(parsed["thread_id"], "thread-1");
+        assert_eq!(parsed["content"], "hi");
+    }
+
+    /// A newline in the message must not become a second record -- a reader
+    /// tailing this file parses one JSON object per line.
+    #[test]
+    fn minds_queued_input_record_escapes_newlines_in_content() {
+        let line = queued_input_record("qid-1", None, "2026-01-01T00:00:00.000Z", "a\nb");
+        assert_eq!(line.matches('\n').count(), 1);
+
+        let parsed: serde_json::Value = serde_json::from_str(line.trim_end()).expect("valid JSON");
+        assert_eq!(parsed["content"], "a\nb");
+        assert!(parsed["thread_id"].is_null());
+    }
+
+    /// Terminating records carry the id and no content -- the reader resolves
+    /// by id, and the content already lives on the enqueue record.
+    #[test]
+    fn minds_queued_terminal_records_carry_id_and_no_content() {
+        for record_type in ["queued_committed", "queued_retracted"] {
+            let line = queued_terminal_record(record_type, "qid-9", "2026-01-01T00:00:00.000Z");
+            assert_eq!(line.matches('\n').count(), 1);
+            let parsed: serde_json::Value =
+                serde_json::from_str(line.trim_end()).expect("valid JSON");
+            assert_eq!(parsed["type"], record_type);
+            assert_eq!(parsed["queued_id"], "qid-9");
+            assert!(
+                parsed.get("content").is_none(),
+                "{record_type} must not re-emit content"
+            );
+        }
+    }
+
+    /// The full lifecycle appends in order and preserves the conservation law:
+    /// replaying the file nets enqueues minus terminals to the pending set.
+    #[test]
+    fn minds_ledger_appends_lifecycle_in_order() {
+        let dir = tempfile::tempdir().expect("tempdir");
+        append_queued_input(dir.path(), "qid-a", Some("t"), "first");
+        append_queued_input(dir.path(), "qid-b", Some("t"), "second");
+        append_queued_committed(dir.path(), "qid-a");
+        append_queued_retracted(dir.path(), "qid-b");
+
+        let contents = fs::read_to_string(queued_input_log_path(dir.path())).expect("log written");
+        let parsed: Vec<serde_json::Value> = contents
+            .lines()
+            .map(|line| serde_json::from_str(line).expect("valid JSON"))
+            .collect();
+        assert_eq!(parsed.len(), 4, "appends must not truncate");
+        assert_eq!(parsed[0]["type"], "queued_input");
+        assert_eq!(parsed[2]["type"], "queued_committed");
+        assert_eq!(parsed[2]["queued_id"], "qid-a");
+        assert_eq!(parsed[3]["type"], "queued_retracted");
+        assert_eq!(parsed[3]["queued_id"], "qid-b");
+    }
+
+    /// The user's message must still be queued when the log cannot be written,
+    /// so the write failure has to stay non-fatal.
+    #[test]
+    fn minds_append_queued_input_survives_an_unwritable_directory() {
+        let dir = tempfile::tempdir().expect("tempdir");
+        let missing = dir.path().join("does-not-exist");
+        append_queued_input(&missing, "qid-1", None, "does not panic");
+        append_queued_committed(&missing, "qid-1");
+        assert!(!queued_input_log_path(&missing).exists());
+    }
+}
