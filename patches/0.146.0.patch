+    SlashCommand::Resume,
+    SlashCommand::Side,
+    SlashCommand::Btw,
+    SlashCommand::Agent,
+    SlashCommand::MultiAgents,
+    SlashCommand::Exit,
+    SlashCommand::Quit,
+    SlashCommand::Keymap,
+    SlashCommand::Vim,
+    SlashCommand::Experimental,
+    SlashCommand::Plan,
