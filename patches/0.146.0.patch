+/// Collect `PersistServiceTierSelection` payloads emitted since the last drain.
+fn persisted_service_tiers(
+    rx: &mut tokio::sync::mpsc::UnboundedReceiver<AppEvent>,
+) -> Vec<Option<String>> {
+    std::iter::from_fn(|| rx.try_recv().ok())
+        .filter_map(|event| match event {
+            AppEvent::PersistServiceTierSelection { service_tier } => Some(service_tier),
+            _ => None,
+        })
+        .collect()
+}
