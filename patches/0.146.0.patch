--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/tests/minds_queue_ledger.rs
@@ -0,0 +1,109 @@
+//! Integration checks for the queued-input ledger emit sites: a mid-turn
+//! submit writes `queued_input` and threads the same id into the turn's
+//! `client_user_message_id`; an interrupt resolves parked steers to
+//! `queued_committed` (Esc flush) or `queued_retracted` (plain interrupt).
+//! Record-format details are covered by `queued_input_log`'s own tests.
+
+use super::*;
+use crate::app_command::AppCommand;
+use pretty_assertions::assert_eq;
+
+fn ledger_records(codex_home: &std::path::Path) -> Vec<serde_json::Value> {
+    let ledger = std::fs::read_to_string(codex_home.join("queued_input.jsonl"))
+        .expect("ledger file written");
+    ledger
+        .lines()
+        .map(|line| serde_json::from_str(line).expect("ledger line is JSON"))
+        .collect()
+}
+
+#[tokio::test]
+async fn minds_mid_turn_submit_writes_ledger_and_threads_id() {
+    let (mut chat, _rx, mut op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    let codex_home = tempfile::tempdir().expect("tempdir");
+    chat.config.codex_home =
+        AbsolutePathBuf::try_from(codex_home.path().to_path_buf()).expect("absolute");
+    chat.thread_id = Some(ThreadId::new());
+    chat.on_task_started();
+
+    chat.submit_user_message(UserMessage::from("steer me"));
+
+    let steer = chat
+        .input_queue
+        .pending_steers
+        .front()
+        .expect("mid-turn submit parks a steer");
+    let queued_id = steer.queued_id.clone().expect("ledger id minted");
+
+    let records = ledger_records(codex_home.path());
+    assert_eq!(records.len(), 1);
+    assert_eq!(records[0]["type"], "queued_input");
+    assert_eq!(records[0]["queued_id"], queued_id.as_str());
+    assert_eq!(records[0]["content"], "steer me");
+
+    let mut client_id = None;
+    while let Ok(op) = op_rx.try_recv() {
+        if let AppCommand::UserTurn {
+            client_user_message_id,
+            ..
+        } = op
+        {
+            client_id = client_user_message_id;
+        }
+    }
+    assert_eq!(client_id.as_deref(), Some(queued_id.as_str()));
+}
+
+#[tokio::test]
+async fn minds_interrupt_resolves_pending_steers_in_the_ledger() {
+    for (flush, expected) in [(false, "queued_retracted"), (true, "queued_committed")] {
+        let (mut chat, _rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+        let codex_home = tempfile::tempdir().expect("tempdir");
+        chat.config.codex_home =
+            AbsolutePathBuf::try_from(codex_home.path().to_path_buf()).expect("absolute");
+        chat.thread_id = Some(ThreadId::new());
+        chat.on_task_started();
+
+        let mut steer = pending_steer("parked text");
+        steer.queued_id = Some("tap-under-test".to_string());
+        chat.input_queue.pending_steers.push_back(steer);
+        chat.input_queue.submit_pending_steers_after_interrupt = flush;
+
+        chat.on_interrupted_turn(TurnAbortReason::Interrupted);
+
+        // The flush path resubmits the merged text, which may itself write a
+        // fresh `queued_input` line under a new id -- filter to the id under
+        // test rather than assuming file order.
+        let resolutions: Vec<String> = ledger_records(codex_home.path())
+            .into_iter()
+            .filter(|record| record["queued_id"] == "tap-under-test")
+            .map(|record| record["type"].as_str().expect("type").to_string())
+            .collect();
+        assert_eq!(resolutions, vec![expected.to_string()], "flush={flush}");
+    }
+}
+
+#[tokio::test]
+async fn minds_model_state_file_mirrors_the_effective_model() {
+    let (mut chat, _rx, _op_rx) = make_chatwidget_manual(/*model_override*/ None).await;
+    let codex_home = tempfile::tempdir().expect("tempdir");
+    chat.config.codex_home =
+        AbsolutePathBuf::try_from(codex_home.path().to_path_buf()).expect("absolute");
+
+    chat.refresh_model_display();
+
+    let state_path = codex_home.path().join("minds_model_state.json");
+    let state = std::fs::read_to_string(&state_path).expect("state file written");
+    let state: serde_json::Value = serde_json::from_str(&state).expect("state is JSON");
+    assert_eq!(
+        state["model"].as_str().expect("model recorded"),
+        chat.effective_collaboration_mode().model()
+    );
+
+    // Tier mutations that bypass refresh_model_display (fast-mode feature
+    // toggles, apply_thread_settings' trailing re-resolution) go through
+    // refresh_effective_service_tier, which must also rewrite the mirror.
+    std::fs::remove_file(&state_path).expect("remove state file");
+    chat.refresh_effective_service_tier();
+    assert!(state_path.exists(), "tier refresh rewrites the state file");
+}
