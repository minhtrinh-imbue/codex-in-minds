+/// Both inline-arg commands Minds adds apply outright instead of opening a
+/// picker, so neither may stop the drain. `/model` regressed exactly this way:
+/// it sits in the static Stop list because *bare* `/model` opens the picker,
+/// which stranded everything queued behind `/model <args>`.
+#[tokio::test]
+async fn minds_queued_inline_args_commands_do_not_strand_the_queue() {
+    for command in ["/fast on", "/model gpt-5.4"] {
+        let (mut chat, _rx, mut op_rx) = make_chatwidget_manual(Some("gpt-5.4")).await;
+        chat.thread_id = Some(ThreadId::new());
+        set_chatgpt_auth(&mut chat);
+        set_fast_mode_test_catalog(&mut chat);
+        chat.set_feature_enabled(Feature::FastMode, /*enabled*/ true);
+        handle_turn_started(&mut chat, "turn-1");
+
+        queue_composer_text_with_tab(&mut chat, command);
+        queue_composer_text_with_tab(&mut chat, "hello after command");
+
+        complete_turn_with_message(&mut chat, "turn-1", Some("done"));
+
+        match next_submit_op(&mut op_rx) {
+            Op::UserTurn { items, .. } => assert_eq!(
+                items,
+                vec![UserInput::Text {
+                    text: "hello after command".to_string(),
+                    text_elements: Vec::new(),
+                }],
+                "queued message should still submit after {command}"
+            ),
+            other => {
+                panic!("after {command}, expected the queued message to submit, got {other:?}")
+            }
+        }
+    }
+}
+
+#[tokio::test]
+async fn minds_slash_model_with_inline_args_applies_model_and_effort() {
+    let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(Some("gpt-5.4")).await;
+    chat.thread_id = Some(ThreadId::new());
+    let _ = drain_insert_history(&mut rx);
+
+    let preset = get_available_model(&chat, "gpt-5.4");
+    let effort = preset
+        .supported_reasoning_efforts
+        .first()
+        .expect("gpt-5.4 should support at least one reasoning effort")
+        .effort
+        .clone();
+
+    chat.dispatch_command_with_args(
+        SlashCommand::Model,
+        format!("gpt-5.4 {}", effort.as_str()),
+        Vec::new(),
+    );
+
+    let events = std::iter::from_fn(|| rx.try_recv().ok()).collect::<Vec<_>>();
+    assert!(
+        events.iter().any(|event| matches!(
+            event,
+            AppEvent::UpdateModel(model) if model == "gpt-5.4"
+        )),
+        "expected model update event; events: {events:?}"
+    );
+    assert!(
+        events.iter().any(|event| matches!(
+            event,
+            AppEvent::UpdateReasoningEffort(Some(applied)) if *applied == effort
+        )),
+        "expected reasoning effort {effort:?}; events: {events:?}"
+    );
+}
