+/// Commands withheld when codex runs inside Minds.
+///
+/// Each one either starts, switches, or destroys a thread, or changes how the
+/// composer interprets input. Minds follows a session by reading its transcript,
+/// so a command that swaps the thread out from under it leaves that view
+/// describing a conversation the user is no longer in. Aliases are listed
+/// alongside their primary (`quit`/`exit`, `btw`/`side`, `subagents`/`agent`)
+/// because each is a distinct variant and blocking only one leaves the other
+/// reachable.
+///
+/// This is a predictability measure, not a containment boundary: Ctrl-C and
+/// Ctrl-D still exit the TUI.
+const MINDS_BLOCKED_COMMANDS: &[SlashCommand] = &[
+    SlashCommand::New,
+    SlashCommand::Clear,
+    SlashCommand::Fork,
+    SlashCommand::Archive,
+    SlashCommand::Delete,
+    SlashCommand::Resume,
+    SlashCommand::Side,
+    SlashCommand::Btw,
+    SlashCommand::Agent,
+    SlashCommand::MultiAgents,
+    SlashCommand::Exit,
+    SlashCommand::Quit,
+    SlashCommand::Keymap,
+    SlashCommand::Vim,
+    SlashCommand::Experimental,
+    SlashCommand::Plan,
+];
+
+/// Always on in a shipped binary. Off by default under `cfg(test)` so the
+/// upstream suite keeps testing upstream behavior: roughly fifteen of its tests
+/// drive a blocked command purely as a vehicle for something else (draft
+/// recall, named sessions, vim reset), and rewriting them would mean rewriting
+/// them again after every rebase. Tests that assert the lockdown itself opt in
+/// with `with_minds_lockdown`.
+#[cfg(not(test))]
+fn minds_lockdown_enabled() -> bool {
+    true
+}
+
+#[cfg(test)]
+fn minds_lockdown_enabled() -> bool {
+    test_lockdown::enabled()
+}
+
+#[cfg(test)]
+pub(crate) mod test_lockdown {
+    use std::cell::Cell;
+
+    // Thread-local, not a global: libtest runs tests as threads in one process.
+    thread_local! {
+        static ENABLED: Cell<bool> = const { Cell::new(false) };
+    }
+
+    pub(crate) fn enabled() -> bool {
+        ENABLED.with(Cell::get)
+    }
+
+    /// Run `f` with the Minds command lockdown active, as a shipped binary has it.
+    pub(crate) fn with_minds_lockdown<T>(f: impl FnOnce() -> T) -> T {
+        ENABLED.with(|flag| flag.set(true));
+        let result = f();
+        ENABLED.with(|flag| flag.set(false));
+        result
+    }
+}
