+/// Regression: `/fast on` applied the tier but left the typed text sitting in the
+/// composer. Inline-arg builtins are consumed by `prepare_live_inline_args`
+/// before their handler runs; service tiers never touch that path.
+#[tokio::test]
+async fn minds_slash_fast_with_args_clears_the_composer() {
+    let (mut chat, mut rx, _op_rx) = make_chatwidget_manual(Some("gpt-5.4")).await;
+    chat.thread_id = Some(ThreadId::new());
+    let _ = drain_insert_history(&mut rx);
+    chat.bottom_pane
+        .set_composer_text("/fast on".to_string(), Vec::new(), Vec::new());
+    assert!(!chat.bottom_pane.composer_text().is_empty(), "test setup");
+
+    chat.handle_service_tier_command_with_args_dispatch(
+        fast_tier_command(),
+        "on".to_string(),
+        /*clear_composer*/ true,
+    );
+
+    assert!(
+        chat.bottom_pane.composer_text().is_empty(),
+        "'/fast on' must not stay in the composer after it is applied"
+    );
