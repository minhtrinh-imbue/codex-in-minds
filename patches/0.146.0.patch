+    /// Apply `/model <model> [effort]` without opening the picker.
+    ///
+    /// Resolves the preset from the same catalog the popup uses, then runs the
+    /// exact `SelectionAction` the popup would have run on Enter, so the effect
+    /// is identical to choosing the pair by hand (including the Ultra and
+    /// plan-mode-scope branches).
+    pub(crate) fn apply_model_selection_from_args(&mut self, args: &str) {
+        if !self.is_session_configured() {
+            self.add_info_message(
+                "Model selection is disabled until startup completes.".to_string(),
+                /*hint*/ None,
+            );
+            return;
+        }
+
+        let mut parts = args.split_whitespace();
+        let Some(model_arg) = parts.next() else {
+            self.open_model_popup();
+            self.defer_input_until_settings_applied();
+            return;
+        };
+        let effort_arg = parts.next();
+        if parts.next().is_some() {
+            self.add_error_message("Usage: /model [model] [effort]".to_string());
+            return;
+        }
+
+        let presets: Vec<ModelPreset> = match self.model_catalog.try_list_models() {
+            Ok(models) => models,
+            Err(_) => {
+                self.add_info_message(
+                    "Models are being updated; please try /model again in a moment.".to_string(),
+                    /*hint*/ None,
+                );
+                return;
+            }
+        };
+
+        let Some(preset) = presets
+            .iter()
+            .find(|preset| preset.model.eq_ignore_ascii_case(model_arg))
+            .cloned()
+        else {
+            let mut known: Vec<String> = presets
+                .iter()
+                .filter(|preset| preset.show_in_picker)
+                .map(|preset| preset.model.clone())
+                .collect();
+            known.sort();
+            known.dedup();
+            self.add_error_message(format!(
+                "Unknown model '{model_arg}'. Available: {}",
+                known.join(", ")
+            ));
+            return;
+        };
+
+        let effort = match effort_arg {
+            None => preset.default_reasoning_effort.clone(),
+            Some(raw) => {
+                // `FromStr` maps any unrecognized string to `Custom`, so the
+                // supported-efforts check below is what actually rejects a typo.
+                let parsed = raw
+                    .to_ascii_lowercase()
+                    .parse::<ReasoningEffortConfig>()
+                    .unwrap_or_else(|_| ReasoningEffortConfig::Custom(raw.to_string()));
+                if !preset
+                    .supported_reasoning_efforts
+                    .iter()
+                    .any(|option| option.effort == parsed)
+                {
+                    let supported: Vec<String> = preset
+                        .supported_reasoning_efforts
+                        .iter()
+                        .map(|option| option.effort.as_str().to_string())
+                        .collect();
+                    self.add_error_message(format!(
+                        "'{}' does not support reasoning effort '{raw}'. Supported: {}",
+                        preset.model,
+                        supported.join(", ")
+                    ));
+                    return;
+                }
+                parsed
+            }
+        };
+
+        let should_prompt_plan_mode_scope =
+            self.should_prompt_plan_mode_reasoning_scope(preset.model.as_str(), Some(effort.clone()));
+        let actions =
+            self.model_selection_actions(preset.model.clone(), Some(effort), should_prompt_plan_mode_scope);
+        for action in actions {
+            action(&self.app_event_tx);
+        }
+        self.defer_input_until_settings_applied();
+    }
